# Copy this file to .env and set the local MySQL credentials.
SHOP_DB_URL=jdbc:mysql://127.0.0.1:3307/balo_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SHOP_DB_USERNAME=root
SHOP_DB_PASSWORD=replace-with-your-local-password
SHOP_DB_H2_CONSOLE=false
# Uncomment only while copying existing H2 data into an empty MySQL database.
# SHOP_DB_MIGRATE_FROM_H2=true
